// Lives here, not in web/, because Bun resolves tsconfig by walking up from the
// source file: without it these files would find web/tsconfig.json and compile
// visage JSX as React.
{
  "extends": "../../tsconfig.base.json",
  // The app compiles against DOM globals, not Bun's. `exactOptionalPropertyTypes`
  // is relaxed as agent-share relaxes it: moonspace's prop types spread optional
  // fields through, and the strict reading rejects `{ error: undefined }`.
  "compilerOptions": { "types": [], "exactOptionalPropertyTypes": false },
  "include": ["."],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
