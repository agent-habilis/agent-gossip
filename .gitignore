# Rust build output. Deliberately unanchored: there is more than one workspace
# here now. `crates/agent-gossip-wasm-client` is excluded from the root
# workspace (it builds for wasm32 and nowhere else), so it carries its own
# target/ — 1.2 GB of it. An anchored `/target` covered only the root's.
target/

# Generated roff man pages. `cargo task man` writes them under /target, but the
# release workflow's download-artifact drops them here before the build runs —
# untracked, which vergen's `dirty(true)` counts, stamping every shipped binary
# `dirty:true`.
/man

# Node
node_modules/

# Editor / agent local state
.claude/
.cursor/
.idea/
.vscode/

# macOS (no leading slash -> matches at every depth, e.g. pi-extension/.DS_Store)
.DS_Store

# Local sync tooling (Syncthing, environment-specific)
.stignore

# Runtime artifacts: daemon IPC sockets, pids, logs
*.log
*.sock
*.pid

# Agent-session scratch at the repo root (plan-file / plan-file-todo output)
/todo.md
/plan.md
/*-plan.md
